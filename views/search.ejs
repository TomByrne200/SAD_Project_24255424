<%- include('partials/header')%>
    <h1>
        results for: <%- q %></h1>
    </h1>

    <% if (error) { %>}
        <p class= "error"><%=error %></p>
    <% } else if (results.length === 0) { %>
        <p>no posts found</p>
    <% }%>

    <% results.forEach(post => { %>
        <article>
            <h2><a href="/posts/<%= post.id %>#from=<%= encodeURIComponent(q)%>"><%=post.title %></a></h2>
            <p> by <%= post.username %> . <%= post.created_at %></p>
        </article>
    <% })%> 
<%- include('partials/footer')%>